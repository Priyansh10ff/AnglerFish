# TinyFish API key — https://docs.tinyfish.ai/authentication
TINYFISH_API_KEY=your_key_here

# Proxy country for agent runs (ISO 3166-1 alpha-2). The event brief says
# TinyFish proxies cover US, GB, CA, DE, FR, JP, AU — try IN first, fall back to US.
TINYFISH_PROXY_COUNTRY=IN

# lite (default) or stealth — stealth helps on hostile scam sites
TINYFISH_BROWSER_PROFILE=stealth
